  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TabDock.App\TabDock.App.csproj" />
  </ItemGroup>

  <!-- Las pruebas de contraste y de movimiento leen los temas directamente. -->
