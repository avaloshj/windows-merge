    <None Include="..\..\src\TabDock.App\Themes\Light.xaml" Link="Themes\Light.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\TabDock.App\Themes\Dark.xaml" Link="Themes\Dark.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\TabDock.App\Themes\Motion.xaml" Link="Themes\Motion.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\TabDock.App\Themes\Motion.Reduced.xaml" Link="Themes\Motion.Reduced.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
