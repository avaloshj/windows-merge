<Project Sdk="Microsoft.NET.Sdk">

  <!-- Aplicación WPF mínima para pruebas de integración. No referencia ningún proyecto de TabDock. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>TabDock.TestTarget</RootNamespace>
    <StartupObject>TabDock.TestTarget.Program</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
