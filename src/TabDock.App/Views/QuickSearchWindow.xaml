<Window x:Class="TabDock.App.Views.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:TabDock.App.Localization"
        xmlns:vm="clr-namespace:TabDock.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:QuickSearchViewModel}"
        Title="{loc:Loc Search_Title}"
        Width="560"
        SizeToContent="Height"
        MaxHeight="460"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="{StaticResource FontSize.Body}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        Background="{DynamicResource Brush.BgWindow}"
        BorderBrush="{DynamicResource Brush.Border}"
        BorderThickness="1">
  <!-- Paleta flotante: escribir filtra, ↑/↓ eligen, Intro activa, Esc cierra. Se cierra sola al perder el foco. -->
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBox x:Name="QueryBox"
             Style="{StaticResource SearchBox}"
             Height="36"
             Tag="{loc:Loc Search_Placeholder}"
             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
             AutomationProperties.Name="{loc:Loc Search_Title}" />

    <Grid Grid.Row="1" Margin="0,10,0,0">
      <ListBox x:Name="ResultList"
               ItemsSource="{Binding Results}"
               SelectedItem="{Binding Selected}"
               MaxHeight="360"
               BorderThickness="0"
               Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               AutomationProperties.Name="{loc:Loc Search_Results}"
               MouseDoubleClick="OnResultDoubleClick">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Row" CornerRadius="{StaticResource Radius.Tab}" Padding="10,6" Background="Transparent">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.TabHover}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.BadgeBackground}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:QuickSearchItem}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" FontSize="{StaticResource FontSize.Subtitle}" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding GroupTitle}"
                         FontSize="{StaticResource FontSize.Subtitle}" Foreground="{DynamicResource Brush.TextSecondary}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Margin="10,8" Text="{loc:Loc Search_NoResults}" Foreground="{DynamicResource Brush.TextSecondary}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasNoResults}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
  </Grid>
</Window>
