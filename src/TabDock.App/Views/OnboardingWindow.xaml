<Window x:Class="TabDock.App.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:TabDock.App.Localization"
        xmlns:vm="clr-namespace:TabDock.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:OnboardingViewModel}"
        Title="{loc:Loc Onboarding_Title}"
        Width="620" Height="520" MinWidth="520" MinHeight="460"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="{StaticResource FontSize.Body}"
        Background="{DynamicResource Brush.BgWindow}"
        Foreground="{DynamicResource Brush.TextPrimary}">
  <!-- Introducción de 3 pasos del primer arranque (Fase 7). -->
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="StepTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Body}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Subtitle}" />
    </Style>

    <Style x:Key="FooterButton" TargetType="Button">
      <Setter Property="Padding" Value="16,6" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
  </Window.Resources>

  <Grid Margin="32,28,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Paso 1: programas -->
    <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{loc:Loc Onboarding_Step1_Title}" Style="{StaticResource StepTitle}" />
      <TextBlock Text="{loc:Loc Onboarding_Step1_Body}" Style="{StaticResource Body}" />
      <ItemsControl ItemsSource="{Binding Programs}" Focusable="False" AutomationProperties.Name="{loc:Loc Onboarding_Step1_Title}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ProgramChoiceViewModel}">
            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,6,0,0" VerticalContentAlignment="Center"
                      AutomationProperties.Name="{Binding DisplayName}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DisplayName}" />
                <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="{StaticResource Radius.Small}"
                        Background="{DynamicResource Brush.BadgeBackground}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="{loc:Loc Onboarding_Running}" FontSize="{StaticResource FontSize.Badge}" Foreground="{DynamicResource Brush.BadgeText}" />
                </Border>
              </StackPanel>
            </CheckBox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{loc:Loc Onboarding_Step1_Hint}" Style="{StaticResource Hint}" Margin="0,16,0,0" />
    </StackPanel>

    <!-- Paso 2: ajuste recomendado de VS Code -->
    <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{loc:Loc Onboarding_Step2_Title}" Style="{StaticResource StepTitle}" />
      <TextBlock Text="{loc:Loc Onboarding_Step2_Body}" Style="{StaticResource Body}" />
      <TextBox Text="{x:Static vm:OnboardingViewModel.VsCodeSnippet}"
               IsReadOnly="True"
               FontFamily="Cascadia Mono, Consolas"
               FontSize="12"
               Padding="10"
               TextWrapping="Wrap"
               AutomationProperties.Name="{loc:Loc Onboarding_Step2_Title}" />
      <Button Content="{loc:Loc Onboarding_Copy}" HorizontalAlignment="Left" Padding="12,4" Margin="0,8,0,12" Click="OnCopyClick"
              AutomationProperties.Name="{loc:Loc Onboarding_Copy}" />
      <TextBlock x:Name="CopiedText" Text="{loc:Loc Onboarding_Copied}" Style="{StaticResource Hint}" Visibility="Collapsed"
                 AutomationProperties.LiveSetting="Polite" />
      <TextBlock Text="{loc:Loc Onboarding_Step2_Hint}" Style="{StaticResource Hint}" />
    </StackPanel>

    <!-- Paso 3: probar el atajo -->
    <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{loc:Loc Onboarding_Step3_Title}" Style="{StaticResource StepTitle}" />
      <TextBlock Text="{loc:Loc Onboarding_Step3_Body}" Style="{StaticResource Body}" />
      <Border HorizontalAlignment="Left" Padding="16,10" Margin="0,4,0,16" CornerRadius="{StaticResource Radius.Control}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Background="{DynamicResource Brush.BgSidebar}">
        <TextBlock Text="{Binding MergeHotkeyText}" FontSize="22" FontWeight="SemiBold" AutomationProperties.Name="{Binding MergeHotkeyText}" />
      </Border>
      <Button Content="{loc:Loc Onboarding_MergeNow}" HorizontalAlignment="Left" Padding="12,4" Click="OnMergeNowClick"
              AutomationProperties.Name="{loc:Loc Onboarding_MergeNow}" />
      <TextBlock Text="{loc:Loc Onboarding_Merged}" FontWeight="Medium" Margin="0,16,0,0" TextWrapping="Wrap"
                 Visibility="{Binding HasMerged, Converter={StaticResource BoolToVisibility}}"
                 AutomationProperties.LiveSetting="Polite" />
      <TextBlock Text="{loc:Loc Onboarding_Step3_Hint}" Style="{StaticResource Hint}" Margin="0,16,0,0" />
    </StackPanel>

    <!-- Pie: progreso y navegación -->
    <DockPanel Grid.Row="1" Margin="0,16,0,0" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" Text="{Binding StepText}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"
                 AutomationProperties.LiveSetting="Polite" />
      <Button DockPanel.Dock="Right" x:Name="NextButton" Command="{Binding NextCommand}" IsDefault="True">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource FooterButton}">
            <Setter Property="Content" Value="{loc:Loc Onboarding_Next}" />
            <Setter Property="AutomationProperties.Name" Value="{loc:Loc Onboarding_Next}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                <Setter Property="Content" Value="{loc:Loc Onboarding_Finish}" />
                <Setter Property="AutomationProperties.Name" Value="{loc:Loc Onboarding_Finish}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button DockPanel.Dock="Right" Content="{loc:Loc Onboarding_Back}" Style="{StaticResource FooterButton}" Command="{Binding BackCommand}"
              AutomationProperties.Name="{loc:Loc Onboarding_Back}" />
      <Button DockPanel.Dock="Right" Content="{loc:Loc Onboarding_Skip}" Style="{StaticResource FooterButton}" Command="{Binding SkipCommand}"
              IsCancel="True" AutomationProperties.Name="{loc:Loc Onboarding_Skip}" />
    </DockPanel>
  </Grid>
</Window>
