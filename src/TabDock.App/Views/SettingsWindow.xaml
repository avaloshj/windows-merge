<Window x:Class="TabDock.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:TabDock.App.Localization"
        xmlns:vm="clr-namespace:TabDock.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="{loc:Loc Settings_Title}"
        Width="820" Height="600" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="{StaticResource FontSize.Body}"
        Background="{DynamicResource Brush.BgWindow}"
        Foreground="{DynamicResource Brush.TextPrimary}">
  <!--
    Ajustes (Fase 7). Sin botón "Aplicar": cada cambio se guarda al momento. Secciones en un TabControl vertical:
    navegación con teclado (Ctrl+Tab, flechas) y nombres accesibles de serie.
  -->
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Margin" Value="0,12,0,6" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Subtitle}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="Warning" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="MinWidth" Value="220" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="MinHeight" Value="30" />
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,12,8,0" />
    </Style>

    <!-- Opciones que todavía no se pueden elegir (p. ej. taskbarOnly). -->
    <Style x:Key="OptionContainer" TargetType="ComboBoxItem">
      <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
    </Style>

    <Style x:Key="SectionTab" TargetType="TabItem">
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="MinWidth" Value="170" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Header, RelativeSource={RelativeSource Self}}" />
    </Style>
  </Window.Resources>

  <TabControl TabStripPlacement="Left"
              Margin="12"
              BorderBrush="{DynamicResource Brush.Border}"
              Background="Transparent"
              ItemContainerStyle="{StaticResource SectionTab}"
              AutomationProperties.Name="{loc:Loc Settings_Title}">

    <!-- General -->
    <TabItem x:Name="GeneralTab" Header="{loc:Loc Settings_Section_General}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Text="{loc:Loc Settings_Section_General}" Style="{StaticResource SectionTitle}" />

          <TextBlock Text="{loc:Loc Settings_Language}" Style="{StaticResource FieldLabel}" />
          <ComboBox ItemsSource="{Binding Languages}"
                    DisplayMemberPath="Label"
                    SelectedValuePath="Value"
                    SelectedValue="{Binding Language}"
                    AutomationProperties.Name="{loc:Loc Settings_Language}" />
          <TextBlock Text="{loc:Loc Settings_LanguageRestart}"
                     Style="{StaticResource Warning}"
                     Visibility="{Binding LanguageNeedsRestart, Converter={StaticResource BoolToVisibility}}"
                     AutomationProperties.LiveSetting="Polite" />

          <TextBlock Text="{loc:Loc Settings_Startup}" Style="{StaticResource FieldLabel}" />
          <CheckBox Content="{loc:Loc Settings_StartWithWindows}"
                    IsChecked="{Binding StartWithWindows}"
                    AutomationProperties.Name="{loc:Loc Settings_StartWithWindows}" />
          <TextBlock Text="{loc:Loc Settings_StartWithWindowsHint}" Style="{StaticResource Hint}" />
          <TextBlock Text="{Binding ErrorMessage}"
                     Style="{StaticResource Warning}"
                     AutomationProperties.LiveSetting="Assertive" />

          <Button Content="{loc:Loc Settings_ShowOnboarding}"
                  Style="{StaticResource ActionButton}"
                  Command="{Binding ShowOnboardingCommand}"
                  Margin="0,24,0,0"
                  AutomationProperties.Name="{loc:Loc Settings_ShowOnboarding}" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- Programas -->
    <TabItem x:Name="ProgramsTab" Header="{loc:Loc Settings_Section_Programs}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel>
          <TextBlock Text="{loc:Loc Settings_Section_Programs}" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{loc:Loc Settings_ProgramsHint}" Style="{StaticResource Hint}" Margin="0,0,0,12" />

          <ItemsControl ItemsSource="{Binding Rules}" Focusable="False" AutomationProperties.Name="{loc:Loc Settings_Section_Programs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:RuleRowViewModel}">
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Padding="14,10" Margin="0,0,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <CheckBox IsChecked="{Binding Enabled}" Margin="0" AutomationProperties.Name="{Binding DisplayName}">
                        <TextBlock>
                          <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="Medium" />
                          <Run Text="{Binding ExecutableName, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </TextBlock>
                      </CheckBox>
                      <WrapPanel Margin="24,4,0,0" IsEnabled="{Binding Enabled}">
                        <CheckBox Content="{loc:Loc Settings_Rule_AutoMerge}" IsChecked="{Binding AutoMerge}" Margin="0,4,16,0"
                                  AutomationProperties.Name="{loc:Loc Settings_Rule_AutoMerge}" />
                        <CheckBox Content="{loc:Loc Settings_Rule_MergeOnStartup}" IsChecked="{Binding MergeOnStartup}" Margin="0,4,16,0"
                                  AutomationProperties.Name="{loc:Loc Settings_Rule_MergeOnStartup}" />
                        <ComboBox ItemsSource="{Binding DataContext.TitleParsers, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding TitleParser}"
                                  MinWidth="200"
                                  Margin="0,4,0,0"
                                  ToolTip="{loc:Loc Settings_Rule_Parser}"
                                  AutomationProperties.Name="{loc:Loc Settings_Rule_Parser}" />
                      </WrapPanel>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{loc:Loc Settings_Rule_Remove}"
                            Padding="10,4"
                            VerticalAlignment="Top"
                            Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{loc:Loc Settings_Rule_Remove}"
                            AutomationProperties.HelpText="{Binding DisplayName}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="{loc:Loc Settings_AddProgram}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
          <TextBlock Text="{loc:Loc Settings_AddProgramHint}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
          <WrapPanel>
            <ComboBox ItemsSource="{Binding AvailablePrograms}"
                      SelectedItem="{Binding SelectedProgram}"
                      MinWidth="320"
                      Margin="0,0,8,0"
                      AutomationProperties.Name="{loc:Loc Settings_AddProgram}" />
            <Button Content="{loc:Loc Settings_AddProgramButton}" Padding="12,4" Margin="0,0,8,0" Command="{Binding AddProgramCommand}"
                    AutomationProperties.Name="{loc:Loc Settings_AddProgramButton}" />
            <Button Content="{loc:Loc Diag_Refresh}" Padding="12,4" Command="{Binding RefreshProgramsCommand}"
                    AutomationProperties.Name="{loc:Loc Diag_Refresh}" />
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- Apariencia -->
    <TabItem x:Name="AppearanceTab" Header="{loc:Loc Settings_Section_Appearance}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Text="{loc:Loc Settings_Section_Appearance}" Style="{StaticResource SectionTitle}" />

          <TextBlock Text="{loc:Loc Settings_Theme}" Style="{StaticResource FieldLabel}" />
          <ComboBox ItemsSource="{Binding Themes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Theme}"
                    AutomationProperties.Name="{loc:Loc Settings_Theme}" />

          <CheckBox Content="{loc:Loc Settings_Mica}" IsChecked="{Binding UseMica}" Margin="0,16,0,0"
                    AutomationProperties.Name="{loc:Loc Settings_Mica}" />
          <TextBlock Text="{loc:Loc Settings_MicaHint}" Style="{StaticResource Hint}" />

          <TextBlock Text="{loc:Loc Settings_Density}" Style="{StaticResource FieldLabel}" />
          <ComboBox ItemsSource="{Binding Densities}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Density}"
                    AutomationProperties.Name="{loc:Loc Settings_Density}" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- Atajos -->
    <TabItem x:Name="HotkeysTab" Header="{loc:Loc Settings_Section_Hotkeys}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel>
          <TextBlock Text="{loc:Loc Settings_Section_Hotkeys}" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{loc:Loc Settings_HotkeysHint}" Style="{StaticResource Hint}" Margin="0,0,0,12" />

          <ItemsControl ItemsSource="{Binding Hotkeys}" Focusable="False" AutomationProperties.Name="{loc:Loc Settings_Section_Hotkeys}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:HotkeyRowViewModel}">
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <CheckBox IsChecked="{Binding IsActive}" Margin="0,0,8,0" VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding CommandLabel}" />
                  <TextBlock Grid.Column="1" Text="{Binding CommandLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBox Grid.Column="2"
                           Text="{Binding KeysText, Mode=OneWay}"
                           IsReadOnly="True"
                           IsReadOnlyCaretVisible="False"
                           IsEnabled="{Binding IsActive}"
                           MinWidth="200"
                           MaxWidth="280"
                           HorizontalAlignment="Left"
                           Padding="6,4"
                           Cursor="Hand"
                           ToolTip="{loc:Loc Settings_HotkeyBoxHint}"
                           PreviewKeyDown="OnHotkeyPreviewKeyDown"
                           GotKeyboardFocus="OnHotkeyGotFocus"
                           LostKeyboardFocus="OnHotkeyLostFocus"
                           AutomationProperties.Name="{Binding CommandLabel}"
                           AutomationProperties.HelpText="{loc:Loc Settings_HotkeyBoxHint}" />
                  <TextBlock Grid.Row="1" Grid.Column="2"
                             Text="{Binding Message}"
                             Style="{StaticResource Warning}"
                             Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.LiveSetting="Assertive" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Content="{loc:Loc Settings_ResetHotkeys}" Style="{StaticResource ActionButton}" Command="{Binding ResetHotkeysCommand}"
                  AutomationProperties.Name="{loc:Loc Settings_ResetHotkeys}" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- Avanzado -->
    <TabItem x:Name="AdvancedTab" Header="{loc:Loc Settings_Section_Advanced}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Text="{loc:Loc Settings_Section_Advanced}" Style="{StaticResource SectionTitle}" />

          <TextBlock Text="{loc:Loc Settings_HideMode}" Style="{StaticResource FieldLabel}" />
          <ComboBox ItemsSource="{Binding HideModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding HideMode}"
                    ItemContainerStyle="{StaticResource OptionContainer}"
                    AutomationProperties.Name="{loc:Loc Settings_HideMode}" />
          <TextBlock Text="{loc:Loc Settings_HideModeHint}" Style="{StaticResource Hint}" />

          <TextBlock Text="{loc:Loc Settings_HealthCheck}" Style="{StaticResource FieldLabel}" />
          <StackPanel Orientation="Horizontal">
            <!-- Mismo rango que UserSettings.Min/MaxHealthCheckSeconds (Slider usa double: x:Static de un int falla). -->
            <Slider Minimum="1"
                    Maximum="10"
                    Value="{Binding HealthCheckSeconds}"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    TickPlacement="BottomRight"
                    Width="260"
                    AutomationProperties.Name="{loc:Loc Settings_HealthCheck}" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center">
              <Run Text="{Binding HealthCheckSeconds, Mode=OneWay}" />
              <Run Text="s" />
            </TextBlock>
          </StackPanel>
          <TextBlock Text="{loc:Loc Settings_HealthCheckHint}" Style="{StaticResource Hint}" />

          <TextBlock Text="{loc:Loc Settings_Rendering}" Style="{StaticResource FieldLabel}" />
          <CheckBox Content="{loc:Loc Settings_LowMemoryRendering}" IsChecked="{Binding LowMemoryRendering}" Margin="0"
                    AutomationProperties.Name="{loc:Loc Settings_LowMemoryRendering}" />
          <TextBlock Text="{loc:Loc Settings_LowMemoryRenderingHint}" Style="{StaticResource Hint}" />
          <TextBlock Text="{loc:Loc Settings_RenderingRestart}"
                     Style="{StaticResource Warning}"
                     Visibility="{Binding RenderingNeedsRestart, Converter={StaticResource BoolToVisibility}}"
                     AutomationProperties.LiveSetting="Polite" />

          <TextBlock Text="{loc:Loc Settings_ForeignCaption}" Style="{StaticResource FieldLabel}" />
          <TextBlock Text="{loc:Loc Settings_ForeignCaptionHint}" Style="{StaticResource Hint}" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- Diagnóstico -->
    <TabItem x:Name="DiagnosticsTab" Header="{loc:Loc Settings_Section_Diagnostics}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Text="{loc:Loc Settings_Section_Diagnostics}" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{loc:Loc Settings_DiagnosticsHint}" TextWrapping="Wrap" />

          <WrapPanel>
            <Button Content="{loc:Loc Settings_ExportDiagnostics}" Style="{StaticResource ActionButton}" Click="OnExportDiagnosticsClick"
                    AutomationProperties.Name="{loc:Loc Settings_ExportDiagnostics}" />
            <Button Content="{loc:Loc Diag_OpenLogs}" Style="{StaticResource ActionButton}" Click="OnOpenLogsClick"
                    AutomationProperties.Name="{loc:Loc Diag_OpenLogs}" />
            <Button Content="{loc:Loc Tray_Diagnostics}" Style="{StaticResource ActionButton}" Click="OnOpenWindowDiagnosticsClick"
                    AutomationProperties.Name="{loc:Loc Tray_Diagnostics}" />
          </WrapPanel>
          <TextBlock x:Name="DiagnosticsStatusText"
                     Text="{Binding DiagnosticsStatus}"
                     Style="{StaticResource Warning}"
                     Margin="0,12,0,0"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
