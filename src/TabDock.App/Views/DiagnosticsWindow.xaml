<Window x:Class="TabDock.App.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:TabDock.App.Localization"
        xmlns:vm="clr-namespace:TabDock.App.ViewModels"
        xmlns:core="clr-namespace:TabDock.Core.Services;assembly=TabDock.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:DiagnosticsViewModel}"
        Title="{loc:Loc Diag_Title}"
        Width="1100" Height="680" MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="{StaticResource FontSize.Body}"
        Background="{DynamicResource Brush.BgWindow}"
        Foreground="{DynamicResource Brush.TextPrimary}">
  <Window.Resources>

    <Style x:Key="ToolbarButton" TargetType="Button">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="MinHeight" Value="32" />
    </Style>

    <Style x:Key="StatusDot" TargetType="Ellipse">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Fill" Value="{DynamicResource Brush.TextSecondary}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static core:EligibilityStatus.Eligible}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Traffic.Zoom}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static core:EligibilityStatus.Disabled}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Traffic.Minimize}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="{loc:Loc Diag_Title}" FontSize="{StaticResource FontSize.Title}" FontWeight="SemiBold" />
      <TextBlock Text="{loc:Loc Diag_Subtitle}" Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
    </StackPanel>

    <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="True">
      <Button DockPanel.Dock="Left"
              Style="{StaticResource ToolbarButton}"
              Content="{loc:Loc Diag_Refresh}"
              Command="{Binding RefreshCommand}"
              IsDefault="True"
              AutomationProperties.Name="{loc:Loc Diag_Refresh}" />
      <Button DockPanel.Dock="Left"
              Style="{StaticResource ToolbarButton}"
              Content="{loc:Loc Diag_OpenLogs}"
              Command="{Binding OpenLogsCommand}"
              AutomationProperties.Name="{loc:Loc Diag_OpenLogs}" />
      <Button DockPanel.Dock="Left"
              Style="{StaticResource ToolbarButton}"
              Content="{loc:Loc Diag_CaptureSelected}"
              ToolTip="{loc:Loc Diag_CaptureHint}"
              Click="OnCaptureSelectedClick"
              AutomationProperties.Name="{loc:Loc Diag_CaptureSelected}"
              AutomationProperties.HelpText="{loc:Loc Diag_CaptureHint}" />
      <Button DockPanel.Dock="Left"
              Style="{StaticResource ToolbarButton}"
              Content="{loc:Loc Diag_OpenDemoFrame}"
              Click="OnOpenDemoFrameClick"
              AutomationProperties.Name="{loc:Loc Diag_OpenDemoFrame}" />
      <CheckBox DockPanel.Dock="Left"
                VerticalAlignment="Center"
                Margin="8,0,16,0"
                Content="{loc:Loc Diag_OnlyEligible}"
                IsChecked="{Binding OnlyEligible}"
                AutomationProperties.Name="{loc:Loc Diag_OnlyEligible}" />
      <CheckBox DockPanel.Dock="Left"
                VerticalAlignment="Center"
                Content="{loc:Loc Diag_ShowTitles}"
                ToolTip="{loc:Loc Diag_ShowTitlesHint}"
                IsChecked="{Binding ShowTitles}"
                AutomationProperties.Name="{loc:Loc Diag_ShowTitles}"
                AutomationProperties.HelpText="{loc:Loc Diag_ShowTitlesHint}" />
      <TextBlock Text="{Binding Summary}"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource Brush.TextSecondary}"
                 AutomationProperties.LiveSetting="Polite" />
    </DockPanel>

    <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}">
      <Grid>
        <DataGrid x:Name="Grid"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource Brush.Border}"
                  BorderThickness="0"
                  Background="Transparent"
                  RowBackground="Transparent"
                  RowHeight="30"
                  SelectionMode="Extended"
                  CanUserResizeRows="False"
                  AutomationProperties.Name="{loc:Loc Diag_Title}">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="{loc:Loc Diag_Col_Status}" Width="130" SortMemberPath="Status">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:WindowRowViewModel}">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                    <Ellipse Style="{StaticResource StatusDot}" />
                    <TextBlock Text="{Binding Status}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{loc:Loc Diag_Col_Reason}" Binding="{Binding Reason}" Width="2*" />
            <DataGridTextColumn Header="{loc:Loc Diag_Col_Executable}" Binding="{Binding Executable}" Width="1.3*" />
            <DataGridTextColumn Header="{loc:Loc Diag_Col_Class}" Binding="{Binding ClassName}" Width="1.5*" />
            <DataGridTextColumn Header="{loc:Loc Diag_Col_Pid}" Binding="{Binding ProcessId}" Width="70" />
            <DataGridTextColumn Header="{loc:Loc Diag_Col_Size}" Binding="{Binding Size}" Width="90" />
            <DataGridTextColumn Header="{loc:Loc Diag_Col_Title}" Binding="{Binding Title}" Width="2*" />
            <DataGridTextColumn Header="{loc:Loc Diag_Col_Handle}" Binding="{Binding Handle}" Width="90" />
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="{loc:Loc Diag_Empty}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.TextSecondary}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </Border>
  </Grid>
</Window>
