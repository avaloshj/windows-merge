<UserControl x:Class="TabDock.App.Controls.CaptionButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TabDock.App.Localization"
             x:Name="Self"
             Focusable="False">
  <!--
    Botones de ventana con el aspecto de Windows 11: 46 px de ancho, glifos de Segoe Fluent Icons
    (Segoe MDL2 Assets en Windows 10), cerrar en rojo #C42B1C al pasar el ratón.
  -->
  <UserControl.Resources>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="{Binding ActualHeight, ElementName=Self}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}">
              <TextBlock x:Name="Glyph"
                         Text="{TemplateBinding Content}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.CaptionHover}" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.CaptionPressed}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}">
              <TextBlock x:Name="Glyph"
                         Text="{TemplateBinding Content}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.CaptionCloseHover}" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.CaptionCloseGlyph}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.CaptionClosePressed}" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.CaptionCloseGlyph}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <StackPanel Orientation="Horizontal">
    <Button x:Name="MinimizeButton"
            Style="{StaticResource CaptionButton}"
            Content="&#xE921;"
            Click="OnMinimizeClick"
            ToolTip="{loc:Loc Frame_Minimize}"
            AutomationProperties.Name="{loc:Loc Frame_Minimize}" />
    <Button x:Name="MaximizeButton"
            Style="{StaticResource CaptionButton}"
            Content="&#xE922;"
            Click="OnMaximizeClick"
            ToolTip="{loc:Loc Frame_Maximize}"
            AutomationProperties.Name="{loc:Loc Frame_Maximize}" />
    <Button x:Name="CloseButton"
            Style="{StaticResource CloseCaptionButton}"
            Content="&#xE8BB;"
            Click="OnCloseClick"
            ToolTip="{loc:Loc Frame_Close}"
            AutomationProperties.Name="{loc:Loc Frame_Close}" />
  </StackPanel>
</UserControl>
