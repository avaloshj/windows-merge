<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:motion="clr-namespace:TabDock.App.Controls.Motion">
  <!--
    Tokens de movimiento. Motion.Reduced.xaml define las mismas claves para "reducir animaciones"
    (todo se convierte en fundidos de 120 ms, sin desplazamientos ni escalas).
    Reglas: desplazamientos ≤ 12 px, sin rebotes ni overshoot.
  -->

  <!-- cubic-bezier(0.22, 1, 0.36, 1): entrada principal. -->
  <motion:CubicBezierEase x:Key="Motion.Ease.Standard" X1="0.22" Y1="1" X2="0.36" Y2="1" />
  <!-- cubic-bezier(0.4, 0, 1, 1): salida. -->
  <motion:CubicBezierEase x:Key="Motion.Ease.Exit" X1="0.4" Y1="0" X2="1" Y2="1" />

  <Duration x:Key="Motion.Duration.Hover">0:0:0.12</Duration>
  <Duration x:Key="Motion.Duration.Indicator">0:0:0.2</Duration>
  <Duration x:Key="Motion.Duration.Frame">0:0:0.25</Duration>
  <Duration x:Key="Motion.Duration.Entrance">0:0:0.3</Duration>
  <Duration x:Key="Motion.Duration.Collapse">0:0:0.18</Duration>

  <!-- Retardo entre pestañas al entrar (ms) y máximo de pestañas escalonadas. -->
  <sys:Double x:Key="Motion.Stagger.Milliseconds">40</sys:Double>
  <sys:Double x:Key="Motion.Stagger.MaxItems">10</sys:Double>

  <sys:Double x:Key="Motion.Entrance.OffsetX">-8</sys:Double>
  <sys:Double x:Key="Motion.Frame.ScaleFrom">0.98</sys:Double>
  <sys:Double x:Key="Motion.Press.Scale">0.98</sys:Double>
  <sys:Boolean x:Key="Motion.Collapse.AnimateHeight">True</sys:Boolean>
</ResourceDictionary>
