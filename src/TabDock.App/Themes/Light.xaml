<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Tema claro. Las claves Color.* las verifica la prueba de contraste WCAG AA. -->
  <Color x:Key="Color.BgWindow">#FDFDFD</Color>
  <Color x:Key="Color.BgSidebar">#F6F7FA</Color>
  <Color x:Key="Color.Border">#EAECF0</Color>
  <Color x:Key="Color.TextPrimary">#0F1115</Color>
  <!-- #6B7280 del diseño original no alcanza 4.5:1 sobre la pestaña con hover: se oscurece ligeramente. -->
  <Color x:Key="Color.TextSecondary">#5F6672</Color>
  <Color x:Key="Color.Accent">#1E7BFF</Color>
  <Color x:Key="Color.TabActive">#FFFFFF</Color>
  <Color x:Key="Color.TabActiveBorder">#E3E5EA</Color>
  <Color x:Key="Color.TabHover">#0F000000</Color>
  <Color x:Key="Color.SearchBackground">#0D000000</Color>
  <Color x:Key="Color.BadgeBackground">#E6F0FF</Color>
  <Color x:Key="Color.BadgeText">#1559C2</Color>
  <Color x:Key="Color.Shadow">#000000</Color>
  <Color x:Key="Color.CaptionHover">#0F000000</Color>
  <Color x:Key="Color.CaptionPressed">#1A000000</Color>
  <Color x:Key="Color.CaptionCloseHover">#C42B1C</Color>
  <Color x:Key="Color.CaptionClosePressed">#C83C31</Color>
  <Color x:Key="Color.CaptionCloseGlyph">#FFFFFF</Color>

  <SolidColorBrush x:Key="Brush.BgWindow" Color="{StaticResource Color.BgWindow}" />
  <SolidColorBrush x:Key="Brush.BgSidebar" Color="{StaticResource Color.BgSidebar}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
  <!-- Separador barra lateral / ventana: sin línea en reposo (la barra lateral pasa a la ventana sin corte). -->
  <SolidColorBrush x:Key="Brush.SplitterLine" Color="Transparent" />
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.TabActive" Color="{StaticResource Color.TabActive}" />
  <SolidColorBrush x:Key="Brush.TabActiveBorder" Color="{StaticResource Color.TabActiveBorder}" />
  <SolidColorBrush x:Key="Brush.TabHover" Color="{StaticResource Color.TabHover}" />
  <SolidColorBrush x:Key="Brush.SearchBackground" Color="{StaticResource Color.SearchBackground}" />
  <SolidColorBrush x:Key="Brush.BadgeBackground" Color="{StaticResource Color.BadgeBackground}" />
  <SolidColorBrush x:Key="Brush.BadgeText" Color="{StaticResource Color.BadgeText}" />
  <SolidColorBrush x:Key="Brush.CaptionHover" Color="{StaticResource Color.CaptionHover}" />
  <SolidColorBrush x:Key="Brush.CaptionPressed" Color="{StaticResource Color.CaptionPressed}" />
  <SolidColorBrush x:Key="Brush.CaptionCloseHover" Color="{StaticResource Color.CaptionCloseHover}" />
  <SolidColorBrush x:Key="Brush.CaptionClosePressed" Color="{StaticResource Color.CaptionClosePressed}" />
  <SolidColorBrush x:Key="Brush.CaptionCloseGlyph" Color="{StaticResource Color.CaptionCloseGlyph}" />
  <SolidColorBrush x:Key="Brush.FocusRing" Color="{StaticResource Color.Accent}" />
  <sys:Double x:Key="Shadow.TabActive.Opacity">0.08</sys:Double>
</ResourceDictionary>
