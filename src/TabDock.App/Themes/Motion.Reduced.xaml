<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:motion="clr-namespace:TabDock.App.Controls.Motion">
  <!-- "Reducir animaciones" activo en Windows: solo fundidos de 120 ms, sin movimiento ni escala. -->
  <motion:CubicBezierEase x:Key="Motion.Ease.Standard" X1="0" Y1="0" X2="1" Y2="1" />
  <motion:CubicBezierEase x:Key="Motion.Ease.Exit" X1="0" Y1="0" X2="1" Y2="1" />

  <Duration x:Key="Motion.Duration.Hover">0:0:0.12</Duration>
  <Duration x:Key="Motion.Duration.Indicator">0:0:0</Duration>
  <Duration x:Key="Motion.Duration.Frame">0:0:0.12</Duration>
  <Duration x:Key="Motion.Duration.Entrance">0:0:0.12</Duration>
  <Duration x:Key="Motion.Duration.Collapse">0:0:0.12</Duration>

  <sys:Double x:Key="Motion.Stagger.Milliseconds">0</sys:Double>
  <sys:Double x:Key="Motion.Stagger.MaxItems">0</sys:Double>

  <sys:Double x:Key="Motion.Entrance.OffsetX">0</sys:Double>
  <sys:Double x:Key="Motion.Frame.ScaleFrom">1</sys:Double>
  <sys:Double x:Key="Motion.Press.Scale">1</sys:Double>
  <sys:Boolean x:Key="Motion.Collapse.AnimateHeight">False</sys:Boolean>
</ResourceDictionary>
