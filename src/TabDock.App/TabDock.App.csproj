<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>TabDock</AssemblyName>
    <RootNamespace>TabDock.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icono del ejecutable: lo usan la barra de tareas, Alt+Tab, el Explorador y las ventanas sin icono propio. -->
    <ApplicationIcon>Assets\TabDock.ico</ApplicationIcon>
    <!-- Strings.resx (neutro) está en español; Strings.en.resx genera el satélite en inglés. -->
    <NeutralLanguage>es</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- Inter (OFL 1.1): pesos estáticos; WPF no interpreta los ejes de las fuentes variables. -->
    <Resource Include="Fonts\*.ttf" />
    <!-- Icono de la bandeja (se lee del recurso al tamaño de icono pequeño del sistema). Se regenera con build\make-icon.ps1. -->
    <Resource Include="Assets\TabDock.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TabDock.Core\TabDock.Core.csproj" />
    <ProjectReference Include="..\TabDock.Infrastructure\TabDock.Infrastructure.csproj" />
    <ProjectReference Include="..\TabDock.Win32\TabDock.Win32.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TabDock.App.Tests" />
  </ItemGroup>

</Project>
